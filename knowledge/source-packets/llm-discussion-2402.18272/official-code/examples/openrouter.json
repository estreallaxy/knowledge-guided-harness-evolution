{
  "discussion": {
    "agents": 6,
    "group_size": 3,
    "rounds": 3,
    "concurrency": 6,
    "max_attempts": 2
  },
  "model": {
    "model": "openai/gpt-6-luna",
    "temperature": null,
    "max_completion_tokens": 2048,
    "timeout": 180,
    "reasoning": {
      "effort": "none"
    },
    "provider": {
      "only": [
        "openai/flex"
      ],
      "allow_fallbacks": false,
      "max_price": {
        "prompt": 0.05,
        "completion": 0.25
      }
    },
    "output_format": "json_schema"
  }
}
