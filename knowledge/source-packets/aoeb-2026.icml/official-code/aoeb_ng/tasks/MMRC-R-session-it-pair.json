{
    "name": "MMRC-R-session-it-pair",
    "data": {
        "query": {
            "path": "json",
            "modal": "TEXT",
            "prompt": "Retrieve the conversation session that contains the information needed to answer the user's memory question.",
            "load_kwargs": {
                "data_files": "${AOEB_DATA_ROOT}/MMRC-R/session-it-pair/query.jsonl"
            }
        },
        "collection": {
            "path": "json",
            "modal": "SEQ",
            "load_kwargs": {
                "data_files": "${AOEB_DATA_ROOT}/MMRC-R/session-it-pair/corpus.jsonl"
            }
        },
        "label": {
            "path": "${AOEB_DATA_ROOT}/MMRC-R/session-it-pair/qrel.tsv",
            "modal": "LABEL",
            "local_file_style": true
        },
        "packages": {
            "images.tar": {"path": "${AOEB_DATA_ROOT}/MMRC-R/session-it-pair/images.tar"}
        }
    }
}
