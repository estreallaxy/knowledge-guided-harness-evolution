{
    "name": "MMRC-R-round-it-pair",
    "restrict_to_qrels": true,
    "data": {
        "query": {
            "path": "json",
            "modal": "TEXT",
            "prompt": "Retrieve the specific conversation round or rounds that contain the information needed to answer the user's memory question.",
            "load_kwargs": {
                "data_files": "${AOEB_DATA_ROOT}/MMRC-R/round-it-pair/query.jsonl"
            }
        },
        "collection": {
            "path": "json",
            "modal": "MIXED",
            "load_kwargs": {
                "data_files": "${AOEB_DATA_ROOT}/MMRC-R/round-it-pair/corpus.jsonl"
            }
        },
        "label": {
            "path": "${AOEB_DATA_ROOT}/MMRC-R/round-it-pair/qrel.tsv",
            "modal": "LABEL",
            "local_file_style": true
        },
        "packages": {
            "images.tar": {"path": "${AOEB_DATA_ROOT}/MMRC-R/round-it-pair/images.tar"}
        }
    }
}
